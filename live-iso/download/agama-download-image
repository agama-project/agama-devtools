#! /bin/bash

# Script for downloading various Agama installation ISO images.

set -eu

ARCH=$(uname -m)
CURRENT_TIME=$(date +%s)
TEMP_KEYRING=""

# cleanup function
function cleanup() {
  if [ -n "$TEMP_KEYRING" ] && [ -f "$TEMP_KEYRING" ]; then
    rm "$TEMP_KEYRING"
  fi
}
trap cleanup EXIT

# --- Colors and Helpers ---
# Check if stderr is a terminal and if it supports at least 8 colors
if [[ -t 2 && $(tput colors 2>/dev/null) -ge 8 ]]; then
  RED=$(tput setaf 1)
  GREEN=$(tput setaf 2)
  YELLOW=$(tput setaf 3)
  NC=$(tput sgr0) # No Color
else
  RED=""
  GREEN=""
  YELLOW=""
  NC=""
fi

# Check for terminal hyperlink support
HYPERLINKS=false
if [[ -t 1 ]]; then
  # TODO: can some other terminals display links?
  if [ "${VTE_VERSION:-0}" -ge 5000 ] ||
    [ "${TERM_PROGRAM:-}" = "vscode" ]; then
    HYPERLINKS=true
  fi
fi

# Display text in red color
function red() {
  echo "${RED}${*}${NC}"
}

# Display text in yellow color
yellow() {
  echo "${YELLOW}${*}${NC}"
}

# Display text in green color
green() {
  echo "${GREEN}${*}${NC}"
}

function print_help() {
  echo "Usage: $0 [options] [image-id]"
  echo
  echo "This script can download various Agama installation ISO images."
  echo
  echo "Options:"
  echo "  -h, --help     Display this help and exit"
  echo "  --arch <arch>  Specify the architecture"
  echo "                 (the default is the current architecture \"${ARCH}\")"
  echo
  echo "Run without arguments to see the list of available ISO images and their IDs."
}

# check if the IBS server is accessible
if curl --head --silent --fail --connect-timeout 5 --max-time 5 -L "https://download.suse.de" >/dev/null; then
  IBS=true
else
  IBS=false
fi

# print relative time to the current time
function relative_time() {
  local DIFF=$((CURRENT_TIME - $1))

  if [[ $DIFF -lt 60 ]]; then
    echo "$DIFF seconds ago"
  elif [[ $DIFF -lt 3600 ]]; then
    echo "$((DIFF / 60)) minutes ago"
  elif [[ $DIFF -lt 86400 ]]; then
    echo "$((DIFF / 3600)) hours ago"
  else
    echo "$((DIFF / 86400)) days ago"
  fi
}

# Find all SLE 16.0 quarterly updates
function quarterly_updates() {
  local BASE_URL="https://download.suse.de/ibs/SUSE:/SLFO:/Products:/SLES:/16.0:"
  curl -L -s "${BASE_URL}/?jsontable" |
    jq -r '.data[] | select(.name|test("^QU[0-9.]+/$")) | .name' | tr -d "/"
}

# Print the SLES ISO name regexp: sles_pattern <version> <offline|online> [name suffix]
function sles_pattern() {
  local KIND="Online"
  [ "$2" = "offline" ] && KIND="Full"
  echo "SLES-${1//./\\.}-${KIND}-${ARCH}-${3:-.*}\\.install\\.iso\$"
}

# Find the latest image in a download directory, prints "<name> <size> <mtime>"
function latest_image() {
  curl -L -s --fail "${1%/}/?jsontable" |
    jq -r --arg pattern "$2" '.data[] | select(.name|test($pattern)) | "\(.name) \(.size) \(.mtime)"' |
    sort -V | tail -n 1
}

# Set the image properties (BASE_URL, PATTERN, DESCRIPTION and optionally the
# checksum/GPG key sources) for the image ID, fails for an unknown ID.
function image_info() {
  local ID="$1"
  local TYPE="${ID##*-}" # offline/online
  local OBS_KEY_URL="https://build.opensuse.org/projects/systemsmanagement:Agama:Devel/signing_keys/download?kind=gpg"
  local SLFO_URL="https://download.suse.de/ibs/SUSE:/SLFO:/Products:/SLES"

  CHECKSUM_DOWNLOAD_URL=""
  GPG_DOWNLOAD_URL=""
  GPG_DOWNLOAD_COMMAND=""

  case "$ID" in
  leap-16.0-offline | leap-16.0-online)
    DESCRIPTION="Official openSUSE Leap 16.0 $TYPE image"
    BASE_URL="https://download.opensuse.org/distribution/leap/16.0/offline"
    PATTERN="Leap-16\\.0-${TYPE}-installer-${ARCH}\\.install\\.iso\$"
    ;;
  sles-16.0-offline | sles-16.0-online)
    DESCRIPTION="Official SLES 16.0 $TYPE image"
    BASE_URL="https://download.suse.de/install/SLES-16-GM"
    PATTERN=$(sles_pattern 16.0 "$TYPE" GM)
    CHECKSUM_DOWNLOAD_URL="${BASE_URL}/SHA256SUMS"
    ;;
  sles-16.0-QU-next-offline | sles-16.0-QU-next-online)
    DESCRIPTION="Testing image for the next SLES 16.0 quarterly update ($TYPE)"
    BASE_URL="${SLFO_URL}:/16.0:/TEST/product/iso/"
    PATTERN=$(sles_pattern 16.0 "$TYPE")
    ;;
  sles-16.0-QU[0-9]*-offline | sles-16.0-QU[0-9]*-online)
    local QU="${ID#sles-16.0-}"
    QU="${QU%-*}"
    DESCRIPTION="SLES 16.0 $QU $TYPE image"
    BASE_URL="${SLFO_URL}:/16.0:/${QU}/product/iso/"
    PATTERN=$(sles_pattern 16.0 "$TYPE")
    ;;
  leap-16.1-beta-offline)
    DESCRIPTION="Testing openSUSE Leap 16.1 Beta offline image"
    BASE_URL="https://download.opensuse.org/distribution/leap/16.1/offline/"
    PATTERN="Leap-16\\.1-offline-installer-${ARCH}-Build.*\\.install\\.iso\$"
    ;;
  leap-16.1-beta-online)
    DESCRIPTION="Testing openSUSE Leap 16.1 Beta online image"
    BASE_URL="https://download.opensuse.org/distribution/leap/16.1/installer/iso/"
    PATTERN="agama-installer\\.${ARCH}-.*-Leap_16\\.1-Build.*\\.iso\$"
    ;;
  sles-16.1-beta-offline | sles-16.1-beta-online)
    DESCRIPTION="Testing SLES 16.1 Beta $TYPE image"
    BASE_URL="https://download.suse.de/install/SLES-16.1-LATEST/"
    PATTERN=$(sles_pattern 16.1 "$TYPE")
    CHECKSUM_DOWNLOAD_URL="${BASE_URL}SHA256SUMS"
    ;;
  devel-tw)
    DESCRIPTION="The latest openSUSE Tumbleweed image from systemsmanagement:Agama:Devel project"
    BASE_URL="https://download.opensuse.org/repositories/systemsmanagement:/Agama:/Devel/images/iso/"
    PATTERN="${ARCH}-.*Build.*\\.iso\$"
    GPG_DOWNLOAD_URL="$OBS_KEY_URL"
    ;;
  devel-leap)
    DESCRIPTION="The latest openSUSE Leap image from systemsmanagement:Agama:Devel project"
    BASE_URL="https://download.opensuse.org/repositories/systemsmanagement:/Agama:/Devel/images_Leap_16.1/iso/"
    PATTERN="${ARCH}-.*Build.*\\.iso\$"
    GPG_DOWNLOAD_URL="$OBS_KEY_URL"
    ;;
  devel-sles)
    DESCRIPTION="Latest development SLES 16.1 online image (Devel:YaST:Agama:Head)"
    BASE_URL="https://download.suse.de/ibs/Devel:/YaST:/Agama:/Head/images_SLES-16.1/iso/"
    PATTERN="${ARCH}-.*Build.*\\.iso\$"
    GPG_DOWNLOAD_COMMAND="osc -A https://api.suse.de signkey Devel:YaST:Agama:Head"
    ;;
  devel-sles-slfo-test-offline | devel-sles-slfo-test-online)
    DESCRIPTION="Latest development SLES 16.1 Beta $TYPE image (SLFO:Test)"
    BASE_URL="${SLFO_URL}:/16.1:/TEST/product/iso/"
    PATTERN=$(sles_pattern 16.1 "$TYPE")
    ;;
  devel-sles-slfo-offline | devel-sles-slfo-online)
    DESCRIPTION="Latest development SLES 16.1 Beta $TYPE image (SLFO)"
    BASE_URL="${SLFO_URL}:/16.1/product/iso/"
    PATTERN=$(sles_pattern 16.1 "$TYPE")
    ;;
  devel-branch-*)
    local BRANCH="${ID#devel-branch-}"
    DESCRIPTION="The experimental image from systemsmanagement:Agama:branches:${BRANCH} project"
    BASE_URL="https://download.opensuse.org/repositories/systemsmanagement:/Agama:/branches:/${BRANCH}/images/iso/"
    PATTERN="${ARCH}-.*-openSUSE-Build.*\\.iso\$"
    GPG_DOWNLOAD_URL="$OBS_KEY_URL"
    ;;
  *)
    return 1
    ;;
  esac
}

# Print a section heading underlined with the given character
function heading() {
  echo "$2"
  printf '%*s\n' "${#2}" "" | tr " " "$1"
}

# Print the ISO image summary
function print_image() {
  local DATA
  DATA=$(latest_image "$1" "$2")

  if [ -z "$DATA" ]; then
    red "  ISO image not found"
    return
  fi

  local NAME SIZE MTIME
  read -r NAME SIZE MTIME <<<"$DATA"
  local BASE_URL="${1%/}/"

  local HUMAN_SIZE DATE REL_TIME
  # format the size to kiB/MiB/... as needed
  HUMAN_SIZE=$(numfmt --to=iec-i --suffix=B "$SIZE")
  DATE=$(date -d "@$MTIME" +"%Y-%m-%d %H:%M:%S")
  REL_TIME=$(relative_time "$MTIME")

  if [ "$HYPERLINKS" = "true" ]; then
    # print the ISO URL as a clickable link
    printf "  ISO: \e]8;;%s%s\e\\%s%s%s\e]8;;\e\\ (%s, %s - %s)\n" \
      "$BASE_URL" "$NAME" "$YELLOW" "$NAME" "$NC" "$HUMAN_SIZE" "$DATE" "$REL_TIME"
  else
    # display a plain link
    echo "  ISO: ${YELLOW}${BASE_URL}${NAME}${NC} ($HUMAN_SIZE, $DATE - $REL_TIME)"
  fi
}

# Print the ID, description and the latest ISO of an image
function print_image_entry() {
  image_info "$1"
  printf "  ID: "
  green "$1"
  echo "  Description: $DESCRIPTION"
  print_image "$BASE_URL" "$PATTERN"
}

# Print a group of images (each preceded by an empty line)
function print_group() {
  local ID
  for ID in "$@"; do
    echo
    print_image_entry "$ID"
  done
}

# Print a titled group of images; with "ibs" as the first argument the group
# is skipped when the IBS server is not accessible
function print_titled_group() {
  local IBS_ONLY=false
  if [ "$1" = "ibs" ]; then
    IBS_ONLY=true
    shift
  fi
  local TITLE="$1"
  shift

  echo "  $TITLE"
  printf '  %s\n' "$(heading - "$TITLE" | tail -n 1)"
  if [[ "$IBS_ONLY" == "true" && "$IBS" != "true" ]]; then
    echo
    yellow "  Skipping SLES images, https://download.suse.de is not accessible."
  else
    print_group "$@"
  fi
}

# print summary of the released images
function print_released_images() {
  heading "=" "Released images:"
  echo
  print_titled_group "openSUSE Leap 16.0" leap-16.0-offline leap-16.0-online
  echo
  print_titled_group ibs "SLES 16.0" sles-16.0-offline sles-16.0-online
  echo

  local -a QU_IDS=()
  if [[ "$IBS" == "true" ]]; then
    local UPDATE
    while read -r UPDATE; do
      QU_IDS+=("sles-16.0-${UPDATE}-offline" "sles-16.0-${UPDATE}-online")
    done < <(quarterly_updates)
  fi
  print_titled_group ibs "SLES 16.0 - Quarterly Updates" "${QU_IDS[@]}"
}

# print summary of the testing images
function print_testing_images() {
  heading "=" "Testing images:"
  echo
  print_titled_group ibs "SLES 16.0 - Next QU" sles-16.0-QU-next-offline sles-16.0-QU-next-online
  echo
  print_titled_group "openSUSE Leap 16.1" leap-16.1-beta-offline leap-16.1-beta-online
  echo
  print_titled_group ibs "SLES 16.1" sles-16.1-beta-offline sles-16.1-beta-online
}

# print summary of the development images
function print_development_images() {
  heading "=" "Development images:"
  echo
  print_titled_group "openSUSE" devel-tw devel-leap
  echo
  print_titled_group ibs "SLES" devel-sles devel-sles-slfo-test-offline \
    devel-sles-slfo-test-online devel-sles-slfo-offline devel-sles-slfo-online
}

# Print summary of the experimental images which are built from the Git branches in the OBS
function print_experimental_images() {
  heading "=" "Experimental images:"
  local -a BRANCHES
  readarray -t BRANCHES < <(get_branches)
  local -a IDS=()
  local BRANCH
  for BRANCH in "${BRANCHES[@]}"; do
    IDS+=("devel-branch-${BRANCH}")
  done
  print_group "${IDS[@]}"
}

# Print complete list of Agama images
function print_list() {
  echo "To download an image run:  $0 [image-id]"
  echo
  print_released_images
  echo
  print_testing_images
  echo
  print_development_images
  echo
  print_experimental_images
}

# Get all systemsmanagement:Agama:branches:* OBS projects
function get_branches() {
  curl -L -s -H "accept: application/json" "https://build.opensuse.org/project/subprojects/systemsmanagement:Agama?type=subproject&length=1000" |
    jq -r ".data[] | select(.name|test(\"systemsmanagement:Agama:branches:\")) | .name " | sort |
    sed -e "s/.*systemsmanagement:Agama:branches:\([^<]\+\).*/\\1/"
}

# Verify the GPG signature using the temporary keyring
function verify_signature_with_keyring() {
  if gpg --no-default-keyring --keyring "$TEMP_KEYRING" --verify "$GPG_FILE" "$CHECKSUM_FILE"; then
    green "$CHECKSUM_FILE: GPG signature OK"
  else
    red "$CHECKSUM_FILE: GPG signature verification failed, the file might be corrupted."
    exit 1
  fi
}

# Import a GPG key (printed by the command) into the temporary keyring and verify the signature
function import_key_and_verify() {
  local MESSAGE="$1"
  shift
  echo "$MESSAGE"
  "$@" | gpg --no-default-keyring --keyring "$TEMP_KEYRING" --import
  verify_signature_with_keyring
}

# Set the checksum and GPG file names for the selected hash algorithm
function set_checksum_files() {
  CHECKSUM_URL="${URL}.${HASH_ALGO}"
  CHECKSUM_FILE="${URL##*/}.${HASH_ALGO}"
  GPG_URL="${CHECKSUM_URL}.asc"
  GPG_FILE="${CHECKSUM_FILE}.asc"
}

# Download the checksum file
function download_checksum() {
  echo "Downloading checksum ${CHECKSUM_FILE}..."
  curl --fail -s -L -O "$CHECKSUM_URL"
}

# Verify the GPG signature of the checksum file
function verify_signature() {
  # check if the GPG key is already imported
  local KEY_ID
  KEY_ID=$(LC_ALL=C gpg --verify "$GPG_FILE" "$CHECKSUM_FILE" 2>&1 | grep "using RSA key" | sed -e "s/.*using RSA key \([0-9A-F]\+\).*/\\1/")
  if gpg --list-keys "$KEY_ID" >/dev/null 2>&1; then
    echo "Verifying GPG signature..."
    if gpg --verify "$GPG_FILE" "$CHECKSUM_FILE"; then
      green "GPG signature OK"
    else
      red "GPG signature verification failed, the file might be corrupted."
      exit 1
    fi
    return
  fi

  # use a temporary GPG keyring, do not touch the user's one
  TEMP_KEYRING=$(mktemp --tmpdir agama-devtools-keyring.XXXXXXXX)
  if [ -n "$GPG_DOWNLOAD_COMMAND" ]; then
    # shellcheck disable=SC2086
    import_key_and_verify "Downloading GPG key using command '${GPG_DOWNLOAD_COMMAND}' and importing it into a temporary keyring" \
      $GPG_DOWNLOAD_COMMAND
  elif [ -n "$GPG_DOWNLOAD_URL" ]; then
    import_key_and_verify "Downloading GPG key from ${GPG_DOWNLOAD_URL} and importing it into a temporary keyring" \
      curl -s "$GPG_DOWNLOAD_URL"
  else
    # if the GPG key is not known then try extracting it from the RPM database
    local SHORT_KEY_ID RPM_KEY
    SHORT_KEY_ID=$(echo "$KEY_ID" | tail -c 9 | tr "[:upper:]" "[:lower:]")
    RPM_KEY=$(rpm -qa "gpg-pubkey" | grep "gpg-pubkey-${SHORT_KEY_ID}") || true

    if [ -n "$RPM_KEY" ]; then
      import_key_and_verify "Importing GPG key $RPM_KEY from the RPM database into a temporary keyring" \
        rpm -q --queryformat "%{DESCRIPTION}" "$RPM_KEY"
    # the openSUSE or SUSE keys can be imported also from the GPG servers
    elif [[ "$KEY_ID" =~ ^(35A2F86E29B700A4|B88B2FD43DBDC284|F74F09BC3FA1D6CE|A1BFC02BD588DC46)$ ]]; then
      echo "Importing GPG key $KEY_ID from GPG servers into a temporary keyring"
      gpg --no-default-keyring --keyring "$TEMP_KEYRING" --recv-keys "$KEY_ID"
      verify_signature_with_keyring
    else
      yellow "GPG signature check skipped"
      echo "The GPG key is not known, you have to manually import the respective public key"
    fi
  fi
}

# Verify the checksum signature and then the checksum itself
function verify_checksum_and_signature() {
  local HASH_ALGO="sha256"
  local CHECKSUM_URL CHECKSUM_FILE GPG_URL="" GPG_FILE=""

  if [ -n "$CHECKSUM_DOWNLOAD_URL" ]; then
    CHECKSUM_URL="${CHECKSUM_DOWNLOAD_URL}"
    CHECKSUM_FILE="${CHECKSUM_DOWNLOAD_URL##*/}"
    download_checksum || {
      red "Failed to download checksum file from $CHECKSUM_URL."
      exit 1
    }
  else
    set_checksum_files
    if ! download_checksum; then
      echo "Downloading .sha256 failed, trying .sha512..."
      HASH_ALGO="sha512"
      set_checksum_files
      download_checksum || {
        red "Failed to download checksum"
        exit 1
      }
    fi
  fi

  # remove the lines from the checksum file which do not match the current image
  sed -i "/${URL##*/}$/!d" "$CHECKSUM_FILE"

  if [ -n "$GPG_URL" ]; then
    echo "Downloading GPG signature ${GPG_FILE}..."
    curl -s -L -O "$GPG_URL"
    verify_signature
  fi

  local HASH_NAME="${HASH_ALGO^^}"
  echo "Verifying ${HASH_NAME} checksum..."
  if ${HASH_ALGO}sum --status -c "$CHECKSUM_FILE"; then
    green "${URL##*/}: ${HASH_NAME} checksum OK"
  else
    red "${URL##*/}: ${HASH_NAME} checksum does not match, broken file?"
    exit 1
  fi
}

# Image ID to download
IMAGE=""

# Process the command line arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
  --arch)
    ARCH="$2"
    shift 2
    ;;
  -h | --help)
    print_help
    exit 0
    ;;
  *)
    IMAGE="$1"
    shift
    ;;
  esac
done

# Check if needed jq tool is installed
if ! command -v jq >/dev/null; then
  echo "Error: The required 'jq' tool is not installed."
  exit 1
fi

# Download image not specified, print all available images
if [ -z "$IMAGE" ]; then
  print_list
  exit 0
fi

# Validate the architecture
case "$ARCH" in
x86_64 | aarch64 | s390x | ppc64le) ;;

*)
  echo "Error: Unsupported architecture: $ARCH"
  exit 1
  ;;
esac

# Find the requested ISO image
if ! image_info "$IMAGE"; then
  echo "Error: Unknown image name '$IMAGE'"
  exit 1
fi

ISO_NAME=$(latest_image "$BASE_URL" "$PATTERN" | cut -d" " -f1)
if [ -z "$ISO_NAME" ]; then
  echo "Error: No ISO image found for '$IMAGE'"
  exit 1
fi
URL="${BASE_URL%/}/${ISO_NAME}"

echo "Downloading $IMAGE..."
if command -v wget >/dev/null; then
  # wget displays a better progress so prefer it if available
  wget -c "$URL"
else
  curl -L -C - -O "$URL"
fi

verify_checksum_and_signature
